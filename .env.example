# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MediAI Supabase PostgreSQL Database Configuration
# ==============================================================================
# The application has been reset to a clean state and prepared for Supabase PostgreSQL.
# In the next step, configure your Supabase project credentials below:

# Supabase Project URL & Anon Key (Client / Server SDK)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Database Direct / Pooled Connection URL (PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

# Target Relational Tables:
# - users (app users authentication credentials and roles)
# - patients (patient demographics, registration, medical profile)
# - doctors (physicians, clinical specialties, qualifications, branches)
# - appointments (consultation bookings, scheduling slots, statuses)
# - encounters (clinical visit records, diagnoses, treatments)
# - lab_results (laboratory telemetry, test categories, values, ranges)
# - prescriptions (medications, dosages, frequencies, refill status)
# - feedback (patient care ratings, feedback comments, sentiment)
# ==============================================================================
