# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MediAI Live MySQL Database Configuration (hospital_db)
# ==============================================================================
# DATABASE_MODE controls whether the app connects to live MySQL or uses prototype engine.
# Options: "LIVE_MYSQL" (or "live"), "PROTOTYPE_DEMO" (or "prototype").
# Defaults to PROTOTYPE_DEMO if credentials are unconfigured or placeholder.
DATABASE_MODE="PROTOTYPE_DEMO"

# Server-Side MySQL Configuration Keys:
# Configure these in your AI Studio environment or Secrets panel to connect to live MySQL.
# Never expose these credentials in frontend code or commit secrets to git.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="hospital_user"
MYSQL_PASSWORD="your_database_password"
MYSQL_DATABASE="hospital_db"

# Or provide a single connection string URI:
# DATABASE_URL="mysql://hospital_user:your_password@localhost:3306/hospital_db"

# ------------------------------------------------------------------------------
# CONNECTING LAPTOP MYSQL WORKBENCH TO GOOGLE AI STUDIO (External Network Step):
# ------------------------------------------------------------------------------
# Because Google AI Studio backend runs inside a Google Cloud container:
# 1. "localhost" or "127.0.0.1" inside the container refers to the container, NOT your laptop.
# 2. To allow this cloud backend to reach your local MySQL instance:
#    - Set up a secure encrypted network tunnel on your laptop (e.g. ngrok or Cloudflare Tunnel):
#        ngrok tcp 3306
#    - ngrok will provide an external forwarding address like:
#        tcp://0.tcp.ngrok.io:12345
#    - Update your environment configuration:
#        MYSQL_HOST="0.tcp.ngrok.io"
#        MYSQL_PORT="12345"
#        DATABASE_MODE="LIVE_MYSQL"
# 3. Security & Least Privilege:
#    - Do NOT use the MySQL "root" account.
#    - Create a dedicated least-privilege user in MySQL Workbench:
#        CREATE USER 'hospital_user'@'%' IDENTIFIED BY 'StrongPasswordHere123!';
#        GRANT SELECT, INSERT, UPDATE ON hospital_db.* TO 'hospital_user'@'%';
#        FLUSH PRIVILEGES;
# ==============================================================================
