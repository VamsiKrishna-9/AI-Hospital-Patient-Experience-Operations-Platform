# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MediAI Supabase PostgreSQL Database & Auth Configuration
# ==============================================================================
# The application connects directly to Supabase Auth and PostgreSQL via the official
# @supabase/supabase-js client library.
# Configure these variables in your deployment environment or secrets panel:

# 1. Supabase Project REST / Auth API URL
# Example: https://xyzcompany.supabase.co
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# 2. Supabase Secret Service-Role Key (CONFIDENTIAL — Server-Side Only)
# Used exclusively inside server.ts for administrative operations and trusted provisioning.
# NEVER expose this key in client-side code, frontend bundles, logs, or API responses.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Supabase Public Anon Key
# Public client key used for anonymous operations and client-scoped authentication.
SUPABASE_ANON_KEY="your-supabase-anon-key"

# 4. Direct / Pooled PostgreSQL Connection URL (Optional)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

# 5. Privileged Account Provisioning Invitation Codes (CONFIDENTIAL — Server-Side Only)
# Comma-separated authorized invitation keys for clinical and administrative onboarding.
# NEVER expose these in client code, public APIs, or frontend bundles.
HOSPITAL_INVITE_CODES="your-hospital-clinical-invite-codes"
ADMIN_INVITATION_CODES="your-hospital-admin-invitation-codes"

# Target Relational Tables (10 Canonical Silver Entities):
# - app_users (auth.users 1:1 mapping, role assignment, security flags)
# - silver_patients (demographics, contact, registration, medical profile)
# - silver_doctors (physicians, specialties, qualifications, branches, rating)
# - silver_staff (hospital staff, roles, departments, shifts, contacts)
# - silver_appointments (consultation bookings, scheduling slots, statuses)
# - silver_encounters (clinical visit records, diagnoses, treatments)
# - silver_prescriptions (medications, dosages, frequencies, duration)
# - silver_lab_results (laboratory telemetry, test categories, values, ranges)
# - silver_feedback (patient care ratings, feedback comments, metrics)
# - silver_staff_assignment (exact 14-column clinical shift assignment table)
# ==============================================================================
